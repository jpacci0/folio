{
  "name": "folio-pdf",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.12.0" },
  "description": "Un luogo semplice e curato per i tuoi PDF. Desktop, locale, senza account.",
  "author": "Jacopo",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "predev": "node scripts/prepare-assets.mjs",
    "predesktop:dev": "node scripts/prepare-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "desktop:dev": "node scripts/dev-desktop.mjs",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "test": "tsx --test tests/pdf.test.ts",
    "pretest:ui": "node scripts/prepare-assets.mjs",
    "test:ui": "playwright test",
    "test:desktop": "node tests/desktop.cjs",
    "pack": "npm run build && node scripts/package-portable.mjs",
    "pack:exe": "electron-builder --prepackaged release/Folio-Windows --win portable --x64",
    "pack:installer": "electron-builder --prepackaged release/Folio-Windows --win nsis --x64"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@fontsource/inter": "^5.2.0",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "it.folio.pdf",
    "productName": "Folio",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": "portable", "signAndEditExecutable": false },
    "portable": { "artifactName": "Folio-${version}-Windows.exe" },
    "nsis": {
      "artifactName": "Folio-${version}-Setup-x64.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Folio",
      "installerLanguages": ["it_IT", "en_US"],
      "language": "1040",
      "deleteAppDataOnUninstall": false,
      "packElevateHelper": false
    }
  }
}
